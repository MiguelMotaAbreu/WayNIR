# Banco local. DATABASE_URL e POSTGRES_PORT precisam usar a mesma porta.
DATABASE_URL=postgresql://waynir:troque_esta_senha@127.0.0.1:5432/waynir
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_PORT=5432

# Cookie seguro deve permanecer true em produção com HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=waynir_session
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Usada somente por `npm run db:seed`.
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Administrador WayNIR
ADMIN_INITIAL_PASSWORD=defina_uma_senha_temporaria_forte
